---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Daniel Sleiman | Systems, Software & Experimental Research",
	description =
		"The portfolio of Daniel Sleiman: practical systems work, software projects, and bounded independent research experiments.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://sleiman.dev');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f4f0e6" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="sleiman.dev" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<slot />
	</body>
</html>
