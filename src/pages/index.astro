---
import { Image } from 'astro:assets';
import architectSketch from '../assets/architect-original-sketch.jpg';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { projects } from '../data/projects';
import Layout from '../layouts/Layout.astro';

const socialLinks = [
	{ label: 'GitHub', handle: '@ItsReallyDanii', href: 'https://github.com/ItsReallyDanii' },
	{ label: 'LinkedIn', handle: 'danielsleiman', href: 'https://www.linkedin.com/in/danielsleiman/' },
	{ label: 'ORCID', handle: '0009-0004-6906-7112', href: 'https://orcid.org/0009-0004-6906-7112' },
];
---

<Layout>
	<SiteHeader />
	<main id="main-content">
		<section class="hero page-section" id="home" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">FIELD NOTES / VOL. 01</p>
				<h1 id="hero-title">Hi, I’m <span>Daniel.</span></h1>
				<p class="hero-role">Systems, software, and experimental research.</p>
				<p class="hero-intro">
					My background is in making technology reliable. I also build tools that turn open
					questions into explicit models, tests, and evidence—without hiding the limits.
				</p>
				<div class="hero-actions">
					<a class="sketch-button sketch-button--primary" href="#projects">Explore the projects</a>
					<a class="sketch-button" href="#experience">Experience &amp; capabilities</a>
				</div>
				<p class="hero-footnote"><span aria-hidden="true">*</span> reliability first; curiosity always.</p>
			</div>

			<figure class="architect-figure">
				<div class="tape tape--left" aria-hidden="true"></div>
				<div class="tape tape--right" aria-hidden="true"></div>
				<Image
					src={architectSketch}
					alt="Daniel's original ink sketch of a winged, geometric architect character wearing a hard hat and holding a pencil"
					width={720}
					quality={82}
					loading="eager"
					fetchpriority="high"
				/>
				<figcaption>
					<span class="annotation-arrow" aria-hidden="true">↖</span>
					the architect — original sketch
				</figcaption>
			</figure>
			<span class="hero-page-number" aria-hidden="true">01</span>
		</section>

		<section class="page-section ruled-section" id="about" aria-labelledby="about-title">
			<SectionHeading
				id="about-title"
				number="02"
				kicker="ABOUT / WORKING METHOD"
				title="Start with the system."
				note="A useful model exposes what it cannot answer."
			/>
			<div class="about-grid">
				<div class="prose-block">
					<p class="lead">
						I work from operations outward: understand the constraints, make the system dependable,
						then improve the way people interact with it.
					</p>
					<p>
						That foundation comes from IT systems, endpoint administration, identity and access,
						troubleshooting, and project delivery. Independent software and research experiments are
						where I use the same discipline to explore less-settled questions.
					</p>
				</div>
				<div class="process-sketch" aria-label="Working process: observe, model, test, refine">
					<p class="process-label">field loop / repeat as needed</p>
					<ol>
						<li><span>01</span>observe</li>
						<li><span>02</span>model</li>
						<li><span>03</span>test</li>
						<li><span>04</span>refine</li>
					</ol>
				</div>
			</div>
		</section>

		<section class="page-section" id="projects" aria-labelledby="projects-title">
			<SectionHeading
				id="projects-title"
				number="03"
				kicker="SELECTED PROJECTS / FOUR FILES"
				title="Built artifacts, honest boundaries."
				note="Status labels are part of the work—not fine print."
			/>
			<p class="section-intro">
				A selected set of computational tools and research prototypes. Each card separates what
				exists in code from what still needs stronger evidence.
			</p>
			<div class="project-grid">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</section>

		<section class="page-section ruled-section" id="research" aria-labelledby="research-title">
			<SectionHeading
				id="research-title"
				number="04"
				kicker="RESEARCH / OPEN QUESTIONS"
				title="Ideas under construction."
				note="Exploratory ≠ experimentally validated."
			/>
			<div class="research-layout">
				<div class="research-statement">
					<p>
						I’m interested in computational methods that keep provenance, assumptions, and stopping
						conditions visible. The goal is not to make early evidence sound final. It is to make the
						next test worth running.
					</p>
					<p class="research-status">Current scope: computational, synthetic, and proxy evidence.</p>
				</div>
				<ul class="research-themes">
					<li>
						<span class="theme-mark" aria-hidden="true">△</span>
						<div><h3>Physics-guided design</h3><p>Screening candidate geometries within explicit fidelity bounds.</p></div>
					</li>
					<li>
						<span class="theme-mark" aria-hidden="true">◎</span>
						<div><h3>Topological descriptions</h3><p>Machine-readable summaries that preserve source and context.</p></div>
					</li>
					<li>
						<span class="theme-mark" aria-hidden="true">⌁</span>
						<div><h3>Nature-inspired structures</h3><p>Biological ideas as prompts for exploration, not proof of performance.</p></div>
					</li>
				</ul>
			</div>
		</section>

		<section class="page-section" id="experience" aria-labelledby="experience-title">
			<SectionHeading
				id="experience-title"
				number="05"
				kicker="EXPERIENCE / OPERATIONS LOG"
				title="Make it work. Make it legible."
				note="Professional systems work grounds the experiments."
			/>
			<div class="experience-grid">
				<div class="experience-copy">
					<p class="lead">
						My professional work centers on dependable technology operations and clear delivery.
					</p>
					<p>
						Past roles include Information Technology Specialist at Harmony Public Schools and
						Project Manager at Neo Home Automation. I keep the summary here intentionally concise;
						LinkedIn holds the fuller public history.
					</p>
					<a class="text-link" href="https://www.linkedin.com/in/danielsleiman/" target="_blank" rel="noopener noreferrer">
						View experience on LinkedIn <span aria-hidden="true">↗</span>
						<span class="sr-only"> (opens in a new tab)</span>
					</a>
				</div>
				<ul class="capability-list" aria-label="Professional capabilities">
					<li><span>01</span><strong>IT operations</strong><small>Endpoint and systems management</small></li>
					<li><span>02</span><strong>Identity &amp; access</strong><small>Infrastructure and user support</small></li>
					<li><span>03</span><strong>Systems integration</strong><small>APIs, automation, and delivery</small></li>
					<li><span>04</span><strong>Technical practice</strong><small>Troubleshooting and documentation</small></li>
				</ul>
			</div>
		</section>

		<section class="page-section contact-section" id="contact" aria-labelledby="contact-title">
			<SectionHeading
				id="contact-title"
				number="06"
				kicker="CONTACT / PUBLIC CHANNELS"
				title="Continue the conversation."
				note="No contact form. No inbox theater."
			/>
			<div class="contact-layout">
				<div>
					<p class="contact-lead">
						For collaboration, project questions, or a closer look at the work, use one of the
						public profiles here.
					</p>
					<p class="contact-note">Public links only; no personal email is published on this site.</p>
				</div>
				<ul class="contact-links">
					{socialLinks.map((link) => (
						<li>
							<a href={link.href} target="_blank" rel="noopener noreferrer">
								<span>{link.label}</span>
								<small>{link.handle}</small>
								<b aria-hidden="true">↗</b>
								<span class="sr-only"> (opens in a new tab)</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<p><span aria-hidden="true">//</span> End of notebook — more pages in progress.</p>
		<a href="#home">Back to page 01 <span aria-hidden="true">↑</span></a>
	</footer>
</Layout>
